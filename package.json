{
  "name": "cheerit-identity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Common users database and identity service for the CheerIT ecosystem.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "dry-run": "node --env-file-if-exists=.env src/dry-run.ts",
    "dry-run:demo": "node src/dry-run.ts --fixtures fixtures/demo",
    "link": "node --env-file-if-exists=.env src/link.ts",
    "link:verify": "node --env-file-if-exists=.env src/link.ts --verify-only",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "issue-key": "node --env-file-if-exists=.env src/issue-key.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.0"
  }
}
